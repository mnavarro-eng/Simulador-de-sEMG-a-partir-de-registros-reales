
#include "semg.h"

#define DAC_PIN 25  // Salida del DAC1 en el ESP32 (GPIO25)

// Período exacto en microsegundos entre muestras (1 / 2048 s ≈ 488.28 us)
const unsigned long PERIODO_US = 488;

uint16_t indice = 0;
unsigned long tiempoSiguiente = 0;

void setup() {
  // Define el instante en que debe salir la primera muestra
  tiempoSiguiente = micros() + PERIODO_US;
}

void loop() {
  // Compara el tiempo actual con el objetivo sin detener el procesador
  if (micros() >= tiempoSiguiente) {
    // 1. Escribe la muestra actual de 8 bits (0-255) en el DAC del GPIO25
    dacWrite(DAC_PIN, SEMG[indice]);
   
    // 2. Avanza a la siguiente muestra
    indice++;
   
    // 3. Al llegar al final (muestra 30720), vuelve a empezar (bucle continuo)
    if (indice >= N_SEMG) {
      indice = 0;
    }
   
    // 4. Suma el período al instante programado anterior (evita error acumulado)
    tiempoSiguiente += PERIODO_US;
  }
}
